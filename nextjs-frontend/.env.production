# Essential Production Environment Variables
NEXT_PUBLIC_API_URL=https://foodpanda.site/api/v1
NEXT_PUBLIC_SITE_URL=https://foodpanda.site
NODE_ENV=production

# Image serving configuration
NEXT_PUBLIC_BACKEND_URL=https://foodpanda.site
NEXT_PUBLIC_UPLOADS_URL=https://foodpanda.site/uploads

# SEO and Performance - REQUIRED
NEXT_PUBLIC_ENABLE_ANALYTICS=true
